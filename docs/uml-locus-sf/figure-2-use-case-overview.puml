@startuml figure-2-use-case-overview
skinparam dpi 320
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 17
skinparam defaultFontColor #151515
skinparam ArrowColor #353535
skinparam ArrowThickness 1.2
skinparam ActorBorderColor #151515
skinparam ActorFontSize 17
skinparam UsecaseBorderColor #252525
skinparam UsecaseBackgroundColor white
skinparam UsecaseFontSize 17
skinparam RectangleBorderColor #252525
skinparam RectangleBackgroundColor white
skinparam RectangleFontSize 20
skinparam NoteBackgroundColor white
